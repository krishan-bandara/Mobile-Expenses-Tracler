# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is already in .gitignore.

# --- Supabase ---------------------------------------------------------
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key: not required by anything in this app today (see
# src/app/api/scan-bill/route.ts — receipt uploads use the signed-in
# user's own session, scoped by the storage RLS policy). Only fill this
# in if you add admin-only server code later that needs to bypass RLS
# on purpose. Never expose it with a NEXT_PUBLIC_ prefix if you do.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (bill-reading vision model, called directly) ---------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash

# --- App ----------------------------------------------------------------
# Used to build absolute URLs where needed (PWA, storage links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
